# --- database -------------------------------------------------------------
# Matches the docker-compose service below. Change the password before you
# expose this anywhere real.
DATABASE_URL="postgresql://vpssell:vpssell_dev_password@localhost:5432/vpssell?schema=public"

# --- security -------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Encrypts stored server credentials (AES-256-GCM). Generate with the same
# command. Rotating this makes already-stored passwords unreadable.
CREDENTIAL_SECRET="change-me-too-another-long-random-string-32-chars"

# --- app ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- seed admin (only read by prisma/seed.ts) -----------------------------
SEED_ADMIN_EMAIL="admin@vpssell.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# --- supplier sync (optional) -----------------------------------------------
# Enables /admin/supplier. Leave unset to disable that page entirely — it
# never blocks the rest of the app when missing.
# RADIB_API_TOKEN="your-representative-token"
